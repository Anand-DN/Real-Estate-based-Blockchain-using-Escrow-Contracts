# Groq (primary provider)
# Replace with your own key. The key previously committed here was rotated / compromised.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
# Comma-separated alternates tried in order when the primary returns 429.
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Ollama (fallback provider)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b